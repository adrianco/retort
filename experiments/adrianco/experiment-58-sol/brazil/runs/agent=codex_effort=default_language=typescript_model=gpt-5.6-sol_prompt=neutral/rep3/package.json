{
  "name": "brazilian-soccer-mcp",
  "version": "1.0.0",
  "description": "MCP server for querying the bundled Brazilian soccer datasets",
  "type": "module",
  "bin": {
    "brazilian-soccer-mcp": "dist/index.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
