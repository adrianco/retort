{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/data.csv {:mvn/version "1.1.0"}
        org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases {:run {:main-opts ["-m" "soccer.server"]}
           :test {:extra-paths ["test"]
                  :main-opts ["-e" "(require,'soccer.core-test)(let[r(clojure.test/run-tests,'soccer.core-test)](System/exit(if(zero?(+(:fail r)(:error r))),0,1)))"]}}}
