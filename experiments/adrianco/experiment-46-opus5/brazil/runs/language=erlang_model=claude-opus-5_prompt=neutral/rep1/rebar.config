{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{escript_name, bsmcp}.
{escript_main_app, bsmcp}.
{escript_incl_apps, [bsmcp]}.
{escript_emu_args, "%%! -noshell -escript main bsmcp\n"}.

{shell, [{apps, [bsmcp]}]}.

{ct_opts, [{sys_config, []}]}.

{dialyzer, [{warnings, [unknown]}]}.

{profiles, [{test, [{erl_opts, [nowarn_export_all, {d, 'TEST'}]}]}]}.
