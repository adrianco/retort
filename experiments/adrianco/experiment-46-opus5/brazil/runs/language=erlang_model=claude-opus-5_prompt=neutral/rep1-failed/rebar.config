{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{escript_main_app, br_soccer}.
{escript_name, "br_soccer_mcp"}.
{escript_incl_apps, [br_soccer]}.
{escript_emu_args, "%%! -escript main br_soccer -noshell +sbtu +A2\n"}.

{shell, [{apps, [br_soccer]}]}.

{profiles,
 [{test, [{erl_opts, [debug_info, nowarn_export_all]}]}]}.

%% `rebar3 test' builds the escript (the stdio suite drives it) and then
%% runs the unit tests and the BDD acceptance suites.
{alias, [{test, [escriptize, eunit, ct]}]}.

{eunit_opts, [verbose]}.

{ct_opts, [{keep_logs, 5}]}.

{dialyzer, [{warnings, [unknown]}]}.
