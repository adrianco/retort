{erl_opts, [debug_info]}.

{deps, [{cowboy, "2.13.0"}]}.

{shell, [{config, "config/sys.config"}, {apps, [book_api]}]}.

{eunit_opts, [verbose]}.

{relx, [{release, {book_api, "1.0.0"}, [book_api, mnesia, sasl]},
        {sys_config, "config/sys.config"},
        {dev_mode, false},
        {include_erts, false},
        {extended_start_script, true}]}.

{profiles, [{prod, [{relx, [{dev_mode, false}, {include_erts, true}]}]}]}.
