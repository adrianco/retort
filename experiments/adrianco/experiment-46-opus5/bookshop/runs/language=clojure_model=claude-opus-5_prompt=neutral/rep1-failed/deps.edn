{:paths ["src" "resources"]

 :deps {org.clojure/clojure          {:mvn/version "1.12.2"}
        ring/ring-core               {:mvn/version "1.15.5"}
        ring/ring-jetty-adapter      {:mvn/version "1.15.5"}
        compojure/compojure          {:mvn/version "1.7.1"}
        cheshire/cheshire            {:mvn/version "6.0.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        org.xerial/sqlite-jdbc       {:mvn/version "3.49.1.0"}
        org.slf4j/slf4j-simple       {:mvn/version "2.0.17"}}

 :aliases
 {;; clj -M:run
  :run  {:main-opts ["-m" "book-api.core"]}

  ;; clj -M:test
  :test {:extra-paths ["test"]
         :extra-deps  {ring/ring-mock {:mvn/version "0.6.2"}}
         :main-opts   ["-m" "book-api.test-runner"]}}}
