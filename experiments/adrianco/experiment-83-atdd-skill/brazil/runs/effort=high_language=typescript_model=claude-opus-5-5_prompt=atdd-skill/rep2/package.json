{
  "name": "brazilian-soccer-mcp",
  "version": "1.0.0",
  "description": "MCP server answering questions about Brazilian soccer from the provided Kaggle datasets",
  "type": "module",
  "main": "dist/src/server.js",
  "bin": {
    "brazilian-soccer-mcp": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run build && vitest run",
