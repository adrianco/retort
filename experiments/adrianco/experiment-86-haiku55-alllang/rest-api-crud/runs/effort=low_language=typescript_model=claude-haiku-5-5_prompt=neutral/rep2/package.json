{
  "name": "book-collection-api",
  "version": "1.0.0",
  "description": "REST API for managing a book collection, backed by SQLite",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
