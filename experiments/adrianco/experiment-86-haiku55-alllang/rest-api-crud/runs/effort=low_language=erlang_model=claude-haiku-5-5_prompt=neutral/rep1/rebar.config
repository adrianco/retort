{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {cowboy, "2.12.0"},
    {esqlite, "0.8.8"}
]}.

%% esqlite's darwin link omits -bundle, so its NIF links as an executable and
%% cannot be loaded. Add the flag back for the dependency only.
{overrides, [
    {override, esqlite, [
        {port_env, [{"darwin", "LDFLAGS", "-bundle"}]}
    ]}
]}.

{shell, [{apps, [books]}]}.
