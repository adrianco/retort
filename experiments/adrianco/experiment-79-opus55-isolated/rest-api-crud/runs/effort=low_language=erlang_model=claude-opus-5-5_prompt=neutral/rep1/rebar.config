{erl_opts, [debug_info]}.
{deps, [
    {cowboy, "2.12.0"},
    {esqlite, "0.8.8"}
]}.
{shell, [{apps, [books]}]}.

%% esqlite drops -bundle from its macOS link flags, which makes recent
%% toolchains try to link the NIF as an executable. Put it back.
{overrides, [
    {add, esqlite, [
        {port_env, [{"darwin", "LDFLAGS", "$LDFLAGS -bundle"}]}
    ]}
]}.
